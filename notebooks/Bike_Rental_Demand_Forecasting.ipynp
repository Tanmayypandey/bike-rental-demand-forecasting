,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          1\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"datetime\",\n      \"properties\": {\n        \"dtype\": \"date\",\n        \"min\": \"2011-01-01 00:00:00\",\n        \"max\": \"2011-01-01 04:00:00\",\n        \"num_unique_values\": 5,\n        \"samples\": [\n          \"2011-01-01 01:00:00\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"cnt\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 15,\n        \"min\": 1,\n        \"max\": 40,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          40\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"code","source":["plt.figure(figsize=(12, 5))\n","\n","sns.histplot(\n","    df[\"cnt\"],\n","    bins=50,\n","    kde=True,\n","    color=\"royalblue\"\n",")\n","\n","plt.title(\"Distribution of Hourly Bike Rental Demand\")\n","plt.xlabel(\"Number of Bike Rentals\")\n","plt.ylabel(\"Frequency\")\n","\n","plt.tight_layout()\n","\n","plt.savefig(\n","    os.path.join(\n","        CHART_PATH,\n","        \"01_demand_distribution.png\"\n","    ),\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":495},"id":"oMPcchcmJFCw","executionInfo":{"status":"ok","timestamp":1791793377869,"user_tz":-330,"elapsed":821,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"5b96e0cf-0e89-40c5-98c4-b444ea386759"},"execution_count":31,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["hourly_demand = (\n","    df.groupby(\"hr\")[\"cnt\"]\n","    .mean()\n","    .reset_index()\n",")\n","\n","plt.figure(figsize=(12, 5))\n","\n","sns.lineplot(\n","    data=hourly_demand,\n","    x=\"hr\",\n","    y=\"cnt\",\n","    marker=\"o\",\n","    color=\"darkorange\"\n",")\n","\n","plt.title(\"Average Bike Demand by Hour\")\n","plt.xlabel(\"Hour of Day\")\n","plt.ylabel(\"Average Bike Rentals\")\n","plt.xticks(range(0, 24))\n","\n","plt.tight_layout()\n","\n","plt.savefig(\n","    os.path.join(\n","        CHART_PATH,\n","        \"02_average_demand_by_hour.png\"\n","    ),\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":495},"id":"Fx9LoiucJHlB","executionInfo":{"status":"ok","timestamp":1791793378579,"user_tz":-330,"elapsed":708,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"d07a681c-4b89-4396-ae23-beffe65f6ada"},"execution_count":32,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["monthly_demand = (\n","    df.groupby(\"mnth\")[\"cnt\"]\n","    .mean()\n","    .reset_index()\n",")\n","\n","plt.figure(figsize=(10, 5))\n","\n","sns.barplot(\n","    data=monthly_demand,\n","    x=\"mnth\",\n","    y=\"cnt\",\n","    color=\"seagreen\"\n",")\n","\n","plt.title(\"Average Bike Demand by Month\")\n","plt.xlabel(\"Month\")\n","plt.ylabel(\"Average Bike Rentals\")\n","\n","plt.tight_layout()\n","\n","plt.savefig(\n","    os.path.join(\n","        CHART_PATH,\n","        \"03_average_demand_by_month.png\"\n","    ),\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":501},"id":"tUyxhWeJKtvn","executionInfo":{"status":"ok","timestamp":1791793379141,"user_tz":-330,"elapsed":552,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"fc380bb6-3900-4043-d2ce-6958fadbe017"},"execution_count":33,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["weather_demand = (\n","    df.groupby(\"weathersit\")[\"cnt\"]\n","    .mean()\n","    .reset_index()\n",")\n","\n","plt.figure(figsize=(8, 5))\n","\n","ax = sns.barplot(\n","    data=weather_demand,\n","    x=\"weathersit\",\n","    y=\"cnt\",\n","    color=\"mediumpurple\"\n",")\n","\n","plt.title(\"Average Bike Demand by Weather Condition\")\n","plt.xlabel(\"Weather Condition Code\")\n","plt.ylabel(\"Average Bike Rentals\")\n","\n","for container in ax.containers:\n","    ax.bar_label(container, fmt=\"%.1f\")\n","\n","plt.tight_layout()\n","\n","plt.savefig(\n","    os.path.join(\n","        CHART_PATH,\n","        \"04_demand_by_weather.png\"\n","    ),\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":501},"id":"J-2o7EzzK2uQ","executionInfo":{"status":"ok","timestamp":1791793379623,"user_tz":-330,"elapsed":479,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"741d9c42-28d0-4fad-e38f-11d236fd2e0b"},"execution_count":34,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["model_df = df.copy()\n","\n","# Calendar features\n","model_df[\"day\"] = model_df[\"datetime\"].dt.day\n","model_df[\"day_of_year\"] = model_df[\"datetime\"].dt.dayofyear\n","model_df[\"week_of_year\"] = (\n","    model_df[\"datetime\"]\n","    .dt.isocalendar()\n","    .week\n","    .astype(int)\n",")\n","\n","model_df[\"is_weekend\"] = (\n","    model_df[\"weekday\"].isin([0, 6])\n",").astype(int)\n","\n","model_df[\"time_index\"] = np.arange(len(model_df))\n","\n","# Cyclical hour features\n","model_df[\"hour_sin\"] = np.sin(\n","    2 * np.pi * model_df[\"hr\"] / 24\n",")\n","\n","model_df[\"hour_cos\"] = np.cos(\n","    2 * np.pi * model_df[\"hr\"] / 24\n",")\n","\n","# Cyclical month features\n","model_df[\"month_sin\"] = np.sin(\n","    2 * np.pi * model_df[\"mnth\"] / 12\n",")\n","\n","model_df[\"month_cos\"] = np.cos(\n","    2 * np.pi * model_df[\"mnth\"] / 12\n",")\n","\n","# Historical demand lag features\n","model_df[\"lag_1\"] = model_df[\"cnt\"].shift(1)\n","model_df[\"lag_24\"] = model_df[\"cnt\"].shift(24)\n","model_df[\"lag_168\"] = model_df[\"cnt\"].shift(168)\n","\n","# Rolling features shifted to avoid leakage\n","model_df[\"rolling_mean_24\"] = (\n","    model_df[\"cnt\"]\n","    .shift(1)\n","    .rolling(window=24)\n","    .mean()\n",")\n","\n","model_df[\"rolling_std_24\"] = (\n","    model_df[\"cnt\"]\n","    .shift(1)\n","    .rolling(window=24)\n","    .std()\n",")\n","\n","model_df[\"rolling_mean_168\"] = (\n","    model_df[\"cnt\"]\n","    .shift(1)\n","    .rolling(window=168)\n","    .mean()\n",")\n","\n","rows_before = len(model_df)\n","\n","model_df.dropna(inplace=True)\n","model_df.reset_index(drop=True, inplace=True)\n","\n","rows_after = len(model_df)\n","\n","print(\"Rows before lag features:\", rows_before)\n","print(\"Rows after lag features:\", rows_after)\n","print(\"Rows removed:\", rows_before - rows_after)\n","\n","display(\n","    model_df[\n","        [\n","            \"datetime\",\n","            \"cnt\",\n","            \"lag_1\",\n","            \"lag_24\",\n","            \"lag_168\",\n","            \"rolling_mean_24\",\n","            \"rolling_mean_168\"\n","        ]\n","    ].head()\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":258},"id":"L7DEuWVpK5yp","executionInfo":{"status":"ok","timestamp":1791793379678,"user_tz":-330,"elapsed":51,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"3b213f24-3cf4-49da-c808-2ecd430353ff"},"execution_count":35,"outputs":[{"output_type":"stream","name":"stdout","text":["Rows before lag features: 17379\n","Row