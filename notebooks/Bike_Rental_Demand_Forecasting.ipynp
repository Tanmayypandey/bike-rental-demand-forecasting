,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          60.083333333333336,\n          47.125,\n          51.958333333333336\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"rolling_mean_168\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.12545269500814699,\n        \"min\": 56.19642857142857,\n        \"max\": 56.482142857142854,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          56.416666666666664,\n          56.482142857142854,\n          56.267857142857146\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"code","source":["target_column = \"cnt\"\n","\n","columns_to_exclude = [\n","    \"instant\",\n","    \"dteday\",\n","    \"datetime\",\n","    \"casual\",\n","    \"registered\",\n","    \"cnt\"\n","]\n","\n","X = model_df.drop(\n","    columns=columns_to_exclude\n",")\n","\n","y = model_df[target_column]\n","\n","print(\"Predictor shape:\", X.shape)\n","print(\"Target shape:\", y.shape)\n","\n","print(\"\\nModel features:\")\n","print(X.columns.tolist())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Zh7J-BGqK8S6","executionInfo":{"status":"ok","timestamp":1791793379703,"user_tz":-330,"elapsed":22,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"b13ddc04-ca68-49a5-d023-d4d3b338805b"},"execution_count":36,"outputs":[{"output_type":"stream","name":"stdout","text":["Predictor shape: (17211, 27)\n","Target shape: (17211,)\n","\n","Model features:\n","['season', 'yr', 'mnth', 'hr', 'holiday', 'weekday', 'workingday', 'weathersit', 'temp', 'atemp', 'hum', 'windspeed', 'day', 'day_of_year', 'week_of_year', 'is_weekend', 'time_index', 'hour_sin', 'hour_cos', 'month_sin', 'month_cos', 'lag_1', 'lag_24', 'lag_168', 'rolling_mean_24', 'rolling_std_24', 'rolling_mean_168']\n"]}]},{"cell_type":"code","source":["categorical_features = [\n","    \"season\",\n","    \"yr\",\n","    \"mnth\",\n","    \"hr\",\n","    \"holiday\",\n","    \"weekday\",\n","    \"workingday\",\n","    \"weathersit\"\n","]\n","\n","numerical_features = [\n","    column\n","    for column in X.columns\n","    if column not in categorical_features\n","]\n","\n","print(\"Categorical features:\")\n","print(categorical_features)\n","\n","print(\"\\nNumerical features:\")\n","print(numerical_features)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"NiL7wEIULEYU","executionInfo":{"status":"ok","timestamp":1791793379712,"user_tz":-330,"elapsed":8,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"90cbfb2a-64e5-4a7a-ce72-17e82bf217da"},"execution_count":37,"outputs":[{"output_type":"stream","name":"stdout","text":["Categorical features:\n","['season', 'yr', 'mnth', 'hr', 'holiday', 'weekday', 'workingday', 'weathersit']\n","\n","Numerical features:\n","['temp', 'atemp', 'hum', 'windspeed', 'day', 'day_of_year', 'week_of_year', 'is_weekend', 'time_index', 'hour_sin', 'hour_cos', 'month_sin', 'month_cos', 'lag_1', 'lag_24', 'lag_168', 'rolling_mean_24', 'rolling_std_24', 'rolling_mean_168']\n"]}]},{"cell_type":"code","source":["split_index = int(len(model_df) * 0.80)\n","\n","X_train = X.iloc[:split_index].copy()\n","X_test = X.iloc[split_index:].copy()\n","\n","y_train = y.iloc[:split_index].copy()\n","y_test = y.iloc[split_index:].copy()\n","\n","train_datetime = (\n","    model_df[\"datetime\"]\n","    .iloc[:split_index]\n","    .copy()\n",")\n","\n","test_datetime = (\n","    model_df[\"datetime\"]\n","    .iloc[split_index:]\n","    .copy()\n",")\n","\n","print(\"Training rows:\", X_train.shape[0])\n","print(\"Testing rows:\", X_test.shape[0])\n","\n","print(\"\\nTraining period:\")\n","print(train_datetime.min(), \"to\", train_datetime.max())\n","\n","print(\"\\nTesting period:\")\n","print(test_datetime.min(), \"to\", test_datetime.max())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ayJE1iHlLIK7","executionInfo":{"status":"ok","timestamp":1791793379747,"user_tz":-330,"elapsed":34,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"0f80ad55-28a0-41c6-ce18-31f6dd14a20c"},"execution_count":38,"outputs":[{"output_type":"stream","name":"stdout","text":["Training rows: 13768\n","Testing rows: 3443\n","\n","Training period:\n","2011-01-08 07:00:00 to 2012-08-08 20:00:00\n","\n","Testing period:\n","2012-08-08 21:00:00 to 2012-12-31 23:00:00\n"]}]},{"cell_type":"code","source":["numerical_transformer = Pipeline(\n","    steps=[\n","        (\n","            \"scaler\",\n","            StandardScaler()\n","        )\n","    ]\n",")\n","\n","categorical_transformer = Pipeline(\n","    steps=[\n","        (\n","            \"onehot\",\n","            OneHotEncoder(\n","                handle_unknown=\"ignore\",\n","                sparse_output=False\n","            )\n","        )\n","    ]\n",")\n","\n","preprocessor = ColumnTransformer(\n","    transformers=[\n","        (\n","            \"numerical\",\n","            numerical_transformer,\n","            numerical_features\n","        ),\n","        (\n","            \"categorical\",\n","            categorical_transformer,\n","            categorical_features\n","        )\n","    ],\n","    remainder=\"drop\"\n",")\n","\n","print(\"Preprocessing pipeline created.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"FLSixqaGLKqf","executionInfo":{"status":"ok","timestamp":1791793379757,"user_tz":-330,"elapsed":9,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"c72e7045-4c3d-4e3d-e6d5-622b9e22707b"},"execution_count":39,"outputs":[{"output_type":"stream","name":"stdout","text":["Preprocessing pipeline created.\n"]}]},{"cell_type":"code","source":["def safe_mape(y_true, y_pred):\n","    \"\"\"\n","    Calculate MAPE after excluding actual zero values.\n","    \"\"\"\n","\n","    y_true = np.asarray(y_true)\n","    y_pred = np.asarray(y_pred)\n","\n","    non_zero_mask = y_true != 0\n","\n","    return (\n","        np.mean(\n","            np.abs(\n","                (\n","                    y_true[non_zero_mask] -\n","                    y_pred[non_zero_mask]\n","                ) /\n","                y_true[non_zero_mask]\n","            )\n","        ) * 100\n","    )\n","\n","\n","def evaluate_predictions(\n","    model_name,\n","    y_true,\n","    y_pred\n","):\n","    \"\"\"\n","    Calculate regression performance metrics.\n","    \"\"\"\n","\n","    y_pred = np.maximum(y_pred, 0)\n","\n","    mae = mean_absolute_error(\n","        y_true,\n","        y_pred\n","    )\n","\n","    rmse = np.sqrt(\n","        mean_squared_error(\n","            y_true,\n","            y_pred\n","        )\n","    )\n","\n","    r2 = r2_score(\n","        y_true,\n","        y_pred\n","    )\n","\n","    mape = safe_mape(\n","        y_true,\n","        y_pred\n","    )\n","\n","    return {\n","        \"Model\": model_name,\n","        \"MAE\": round(mae, 3),\n","        \"RMSE\": round(rmse, 3),\n","        \"R2\": round(r2, 4),\n","        \"MAPE_Percentage\": round(mape, 2)\n","    }"],"metadata":{"id":"_OXI1TE_LNJN","executionInfo":{"status":"ok","timestamp":1791793379760,"user_tz":-330,"elapsed":2,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}}},"execution_count":40,"outputs":[]},{"cell_type":"code","source":["baseline_predictions = (\n","    X_test[\"lag_24\"]\n","    .values\n",")\n","\n","results = []\n","\n","baseline_result = evaluate_predictions(\n","    \"Naive Lag-24 Baseline\",\n","    y_test,\n","    baseline_predictions\n",")\n","\n","results.append(baseline_result)\n","\n","display(\n","    pd.DataFrame([baseline_result])\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":81},"id":"UFM7wfmyLPia","executionInfo":{"status":"ok","timestamp":1791793379785,"user_tz":-330,"elapsed":23,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"036e3c61-2191-4d58-cf41-b354548fb0de"},"execution_count":41,"outputs":[{"output_type":"display_data","data":{"text/plain":["                   Model    MAE    RMSE    R2  MAPE_Percentage\n","0  Naive Lag-24 Baseline 81.030 135.376 0.621           78.180"],"text/html":["\n","  <div id=\"df-aa34a918-e741-496a-9764-88548a7f648c\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Model</th>\n","      <th>MAE</th>\n","      <th>RMSE</th>\n","      <th>R2</th>\n","      <th>MAPE_Percentage</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>Naive Lag-24 Baseline</td>\n","      <td>81.030</td>\n","      <td>135.376</td>\n","      <td>0.621</td>\n","      <td>78.180</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>\n","    <div class=\"colab-df-buttons\">\n","\n","  <div class=\"colab-df-container\">\n","    <button class=\"colab-df-convert\" onclick=\"convertToInteractive('df-aa34a918-e741-496a-9764-88548a7f648c')\"\n","            title=\"Convert this dataframe to an interactive table.\"\n","            style=\"display:none;\">\n","\n","  <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\" viewBox=\"0 -960 960 960\">\n","    <path d=\"M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm220 220h160v-160H400v160Zm0 220h160v-160H400v160ZM180-400h160v-160H180v160Zm440 0h160v-160H620v160ZM180-180h160v-160H180v160Zm440 0h160v-160H620v160Z\"/>\n","  </svg>\n","    </button>\n","\n","  <style>\n","    .colab-df