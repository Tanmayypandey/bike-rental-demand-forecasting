y\",\n        \"num_unique_values\": 2,\n        \"samples\": [\n          \"Mist or Cloudy\",\n          \"Clear or Partly Cloudy\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"total_observations\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 19,\n        \"min\": 22,\n        \"max\": 75,\n        \"num_unique_values\": 17,\n        \"samples\": [\n          69,\n          75\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"average_demand\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 40.884442527561426,\n        \"min\": 459.29,\n        \"max\": 598.35,\n        \"num_unique_values\": 20,\n        \"samples\": [\n          598.35,\n          474.97\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"maximum_demand\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 77,\n        \"min\": 761,\n        \"max\": 977,\n        \"num_unique_values\": 20,\n        \"samples\": [\n          963,\n          785\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"code","source":["query_10 = \"\"\"\n","WITH demand_categories AS (\n","    SELECT\n","        cnt,\n","\n","        CASE\n","            WHEN cnt < 50 THEN 'Very Low'\n","            WHEN cnt < 150 THEN 'Low'\n","            WHEN cnt < 300 THEN 'Medium'\n","            WHEN cnt < 500 THEN 'High'\n","            ELSE 'Very High'\n","        END AS demand_category\n","\n","    FROM bike_demand_data\n",")\n","\n","SELECT\n","    demand_category,\n","    COUNT(*) AS total_hours,\n","    ROUND(\n","        COUNT(*) * 100.0 /\n","        (\n","            SELECT COUNT(*)\n","            FROM demand_categories\n","        ),\n","        2\n","    ) AS percentage_of_hours,\n","    ROUND(AVG(cnt), 2) AS average_demand\n","\n","FROM demand_categories\n","\n","GROUP BY demand_category\n","\n","ORDER BY\n","    CASE demand_category\n","        WHEN 'Very Low' THEN 1\n","        WHEN 'Low' THEN 2\n","        WHEN 'Medium' THEN 3\n","        WHEN 'High' THEN 4\n","        WHEN 'Very High' THEN 5\n","    END;\n","\"\"\"\n","\n","sql_results[\"demand_category_distribution\"] = (\n","    pd.read_sql_query(\n","        query_10,\n","        connection\n","    )\n",")\n","\n","display(\n","    sql_results[\"demand_category_distribution\"]\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":206},"id":"DPFGaZWoT17-","executionInfo":{"status":"ok","timestamp":1791795103102,"user_tz":-330,"elapsed":47,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"06eff7a5-2e2e-4ea8-d68e-9ca209144d81"},"execution_count":80,"outputs":[{"output_type":"display_data","data":{"text/plain":["  demand_category  total_hours  percentage_of_hours  average_demand\n","0        Very Low         4737               27.520          18.010\n","1             Low         4074               23.670          97.890\n","2          Medium         4479               26.020         216.760\n","3            High         2634               15.300         383.650\n","4       Very High         1287                7.480         635.340"],"text/html":["\n","  <div id=\"df-e9fc8508-72a2-48d4-a37f-818346895d34\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>demand_category</th>\n","      <th>total