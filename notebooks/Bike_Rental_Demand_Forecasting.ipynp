oin(\n","        CHART_PATH,\n","        \"05_initial_model_comparison.png\"\n","    ),\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":601},"id":"CLtoVqnbLbos","executionInfo":{"status":"ok","timestamp":1791793434915,"user_tz":-330,"elapsed":589,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"8f42dfb1-c5f6-425e-a06e-fe98e1c8d1b1"},"execution_count":45,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1100x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["tuning_pipeline = Pipeline(\n","    steps=[\n","        (\n","            \"preprocessor\",\n","            preprocessor\n","        ),\n","        (\n","            \"model\",\n","            HistGradientBoostingRegressor(\n","                random_state=42\n","            )\n","        )\n","    ]\n",")\n","\n","parameter_distribution = {\n","    \"model__learning_rate\": [\n","        0.03,\n","        0.05,\n","        0.08,\n","        0.10\n","    ],\n","\n","    \"model__max_iter\": [\n","        150,\n","        250,\n","        350\n","    ],\n","\n","    \"model__max_leaf_nodes\": [\n","        15,\n","        31,\n","        63\n","    ],\n","\n","    \"model__min_samples_leaf\": [\n","        10,\n","        20,\n","        30\n","    ],\n","\n","    \"model__l2_regularization\": [\n","        0.0,\n","        0.5,\n","        1.0,\n","        2.0\n","    ]\n","}\n","\n","time_series_cv = TimeSeriesSplit(\n","    n_splits=3\n",")\n","\n","random_search = RandomizedSearchCV(\n","    estimator=tuning_pipeline,\n","    param_distributions=parameter_distribution,\n","    n_iter=10,\n","    scoring=\"neg_mean_absolute_error\",\n","    cv=time_series_cv,\n","    random_state=42,\n","    n_jobs=-1,\n","    verbose=1\n",")\n","\n","random_search.fit(\n","    X_train,\n","    y_train\n",")\n","\n","print(\"Hyperparameter tuning completed.\")\n","\n","print(\"\\nBest parameters:\")\n","print(random_search.best_params_)\n","\n","print(\n","    \"\\nBest cross-validation MAE:\",\n","    round(-random_search.best_score_, 3)\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"55FH9bt5LmwY","executionInfo":{"status":"ok","timestamp":1791793376722,"user_tz":-330,"elapsed":38810,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"ca1b43f9-02bb-4a3e-8fc4-48a346c765e1"},"execution_count":23,"outputs":[{"output_type":"stream","name":"stdout","text":["Fitting 3 folds for each of 10 candidates, totalling 30 fits\n","Hyperparameter tuning completed.\n","\n","Best parameters:\n","{'model__min_samples_leaf': 10, 'model__max_leaf_nodes': 31, 'model__max_iter': 150, 'model__learning_rate': 0.05, 'model__l2_regularization': 0.0}\n","\n","Best cross-validation MAE: 30.146\n"]}]},{"cell_type":"code","source":["best_model = random_search.best_estimator_\n","\n","tuned_predictions = best_model.predict(\n","    X_test\n",")\n","\n","tuned_predictions = np.maximum(\n","    tuned_predictions,\n","    0\n",")\n","\n","tuned_result = evaluate_predictions(\n","    \"Tuned Histogram Gradient Boosting\",\n","    y_test,\n","    tuned_predictions\n",")\n","\n","display(\n","    pd.DataFrame([tuned_result])\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":81},"id":"csT4nMIgLp_A","executionInfo":{"status":"ok","timestamp":1791793376785,"user_tz":-330,"elapsed":67,"user":{"displayName":"Tanmay Pandey","userId":"08267603830918158100"}},"outputId":"8b851551-19b3-443d-d880-89830c75ee83"},"execution_count":24,"outputs":[{"output_type":"display_data","data":{"text/plain":["                               Model    MAE   RMSE    R2  MAPE_Percentage\n","0  Tuned Histogram Gradient Boosting 29.723 47.206 0.954           28.590"],"text/html":["\n","  <div id=\"df-da0472b6-7f4d-4ee0-877d-ab49b5ad8fc9\" class=\"colab-df-container\">\n","    <div>\n","<s